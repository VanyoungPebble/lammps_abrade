# Deliberately small isolated regression input
units cgs
boundary p p p
atom_style hybrid molecular sphere
newton on
region box block -10 10 -10 10 -10 10
create_box 4 box angle/types 1 extra/angle/per/atom 10
angle_style zero
angle_coeff * 75.0
molecule Box data.Box
create_atoms 0 single 0 0 0 mol Box 1729871 rotate 37 1 2 3 units box
neighbor 0.4 multi
comm_modify mode multi vel yes
pair_style granular
pair_coeff * * hertz 1e8 0.55 tangential linear_history 1e8 1.0 0.39 damping coeff_restitution limit_damping
group owning id 1
group owned subtract all owning
set group owning type 4
neigh_modify collection/type 2 1*3 4
comm_modify cutoff/multi 1 6.0 cutoff/multi 2 6.0
neigh_modify exclude molecule/intra all
neigh_modify exclude group owning owned
neigh_modify exclude molecule/inter owning

variable ux atom -50*y+12000
variable uy atom 50*x
velocity all set v_ux v_uy 0
fix abrade all rigid/abrade 1e20 0.25 1.42 molecule normals
compute old all rigid/local_abrade abrade mol volume surface_area abraded_volume wear_energy inertiax inertiay inertiaz
dump old all local 5 old.dump c_old[*]
dump_modify old sort 1 format float %.17g
dump positions all custom 5 atoms.dump id type mol xu yu zu vx vy vz fx fy fz radius
dump_modify positions sort id format float %.17g
compute shape all rigid/local_abrade abrade mol l_obb i_obb s_obb sphericity_wadell obb_valid zingg_s_over_i_obb zingg_i_over_l_obb sphericity_krumbein_obb flatness_potticary_obb elongation_potticary_obb flatness_kong_obb elongation_kong_obb flatness_angelidakis_obb elongation_angelidakis_obb
dump shape all local 5 shape.dump c_shape[*]
dump_modify shape sort 1 format float %.17g
compute single all rigid/local_abrade abrade l_obb
dump single all local 5 single.dump c_single
dump_modify single format float %.17g
timestep 1e-4
thermo 10
thermo_style custom step atoms
run 10
run 10
